meta {
  name: 04 Sin PKCE (debe fallar)
  type: http
  seq: 4
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/auth?client_id={{spaClientId}}&response_type=code&scope=openid&redirect_uri={{callbackUrl}}
  body: none
  auth: none
}

params:query {
  client_id: {{spaClientId}}
  response_type: code
  scope: openid
  redirect_uri: {{callbackUrl}}
}

settings {
  encodeUrl: true
  followRedirects: false
  maxRedirects: 0
}

tests {
  test("Keycloak rechaza la autorización sin code_challenge", function () {
    const status = res.getStatus();
    const location = res.getHeader("location") || "";
    const rejectedByRedirect = status === 302 && location.indexOf("error=invalid_request") !== -1;
    const rejectedByPage = status === 400;
    expect(rejectedByRedirect || rejectedByPage).to.equal(true);
  });
}

docs {
  Prueba negativa (b) de ISS-03: una petición de autorización sin `code_challenge`
  debe rechazarse porque `taskflow-spa` exige PKCE `S256`.
}
