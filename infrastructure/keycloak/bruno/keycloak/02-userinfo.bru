meta {
  name: 02 Userinfo (token con PKCE)
  type: http
  seq: 2
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/userinfo
  body: none
  auth: inherit
}

tests {
  test("el access token obtenido con PKCE es válido", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve sub", function () {
    expect(res.getBody().sub).to.be.a("string");
  });
}

docs {
  Usa el token OAuth 2.0 de la colección (Authorization Code + PKCE con `taskflow-spa`).
  Si no hay token, Bruno abre el login de Keycloak. Prueba (a) de ISS-03.
}
