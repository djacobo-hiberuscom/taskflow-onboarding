meta {
  name: 03 Introspección (taskflow-api)
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token/introspect
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{apiClientId}}
  password: {{process.env.TASKFLOW_API_CLIENT_SECRET}}
}

body:form-urlencoded {
  token: {{$oauth2.credentials.access_token}}
}

tests {
  const body = res.getBody();
  const roles = (body.realm_access && body.realm_access.roles) || [];
  const expectedSubs = {
    "admin.demo": bru.getEnvVar("subAdmin"),
    "usuario.a": bru.getEnvVar("subUsuarioA"),
    "usuario.b": bru.getEnvVar("subUsuarioB"),
    "usuario.c": bru.getEnvVar("subUsuarioC")
  };

  test("el secreto de taskflow-api es válido", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("token activo", function () {
    expect(body.active).to.equal(true);
  });

  test("aud incluye taskflow-api", function () {
    const aud = Array.isArray(body.aud) ? body.aud : [body.aud];
    expect(aud).to.include("taskflow-api");
  });

  test("azp = taskflow-spa", function () {
    expect(body.azp).to.equal("taskflow-spa");
  });

  test("access token de 5 minutos", function () {
    expect(body.exp - body.iat).to.equal(300);
  });

  test("exactamente un rol de negocio (Admin o User)", function () {
    const business = roles.filter(function (r) { return r === "Admin" || r === "User"; });
    expect(business).to.have.lengthOf(1);
  });

  test("sub fijo del usuario de demostración", function () {
    const expected = expectedSubs[body.username];
    if (expected) {
      expect(body.sub).to.equal(expected);
    }
  });
}

docs {
  Simula la introspección que hará la API (authentication.md §5) y comprueba los
  claims del access token: audiencia, cliente, vigencia, rol y `sub` fijo.
  Pruebas (a), (c) y (d) de ISS-03. El token caduca en 5 minutos: si sale
  `active: false`, pide uno nuevo.

  Para un usuario registrado (no de demostración) se omite la comprobación de `sub`;
  el rol de negocio debe ser `User`.
}
