meta {
  name: 01 Discovery OIDC
  type: http
  seq: 1
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/.well-known/openid-configuration
  body: none
  auth: none
}

tests {
  test("el realm existe", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("el emisor es el acordado", function () {
    expect(res.getBody().issuer).to.equal(bru.interpolate("{{keycloakUrl}}/realms/{{realm}}"));
  });

  test("admite PKCE S256", function () {
    expect(res.getBody().code_challenge_methods_supported).to.include("S256");
  });
}

docs {
  Comprueba que el realm `taskflow` está importado y que el emisor coincide con
  `http://localhost:8080/realms/taskflow` (authentication.md §4).
}
